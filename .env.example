APP_NAME='Adilisha Portal'

# Platform credit (shown in footer, login, auth page title). Org logo stays logo.png.
PRODUCT_NAME=DeskOra
PRODUCT_LOGO=assets/images/deskora-logo.svg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=https://portal.marscommltd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adilisha_portal
DB_USERNAME=adilisha_portal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty — do NOT set to "null" (breaks session cookies and causes 419 errors).
SESSION_DOMAIN=
# Set true when APP_URL is https (auto-detected from APP_URL if omitted).
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

LOGIN_OTP_INACTIVITY_HOURS=120
OTP_LENGTH=4
OTP_EXPIRES=10
OTP_FORMAT=numeric

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

CACHE_STORE=database
CACHE_PREFIX=


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=nulls
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

HASHIDS_SALT=
HASHIDS_ALT_SALT=

# Anonymous feedback QR URL: /feedback/{token} — generate: php -r "echo bin2hex(random_bytes(16));"
ANONYMOUS_FEEDBACK_PUBLIC_TOKEN=
# Optional extra inboxes (comma-separated) always notified on new submissions
ANONYMOUS_FEEDBACK_NOTIFY_EMAILS=

VITE_APP_NAME="${APP_NAME}"

# Groq — free-tier AI writing assist on weekly plans/reports (OpenAI-compatible API).
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Quality default: llama-3.3-70b-versatile. Switch to llama-3.1-8b-instant for higher limits/speed.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=500
GROQ_SUMMARY_MAX_TOKENS=800
GROQ_QUESTION_MAX_TOKENS=400
GROQ_TIMEOUT=30
GROQ_SUMMARY_CACHE_ENABLED=true
GROQ_SUMMARY_CACHE_SECONDS=604800
GROQ_MAX_REQUESTS_PER_MINUTE=30
GROQ_ASSISTANT_MAX_TOKENS=600
GROQ_ASSISTANT_MAX_REQUESTS_PER_MINUTE=10


BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
BEEM_BASE_URL=https://apisms.beem.africa/v1


